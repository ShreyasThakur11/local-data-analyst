# Local Data Analyst – Environment Configuration
# Copy this file to .env and adjust values as needed.
# Never commit .env with real secrets.

# --- Server settings ---
# Bind address. Keep localhost for local use.
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_SERVER_PORT=8501

# --- Local AI (optional Ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- Storage paths ---
# STORAGE_DIR=storage
# CACHE_DIR=storage/cache
# LEARNING_DB_PATH=storage/learning.db
# EXPORTS_DIR=storage/exports

# --- Application settings ---
# MAX_UPLOAD_MB=200
# SAMPLE_ROWS_PREVIEW=200
# PROFILING_SAMPLE_LIMIT=50000
